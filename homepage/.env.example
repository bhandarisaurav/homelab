# Homepage widget secrets (referenced as {{HOMEPAGE_VAR_*}} in config/services.yaml)
HOMEPAGE_VAR_PVE_TOKEN=
HOMEPAGE_VAR_PVE_SECRET=
# Immich: Account Settings -> API Keys -> New API Key
HOMEPAGE_VAR_IMMICH_KEY=
# AdGuard Home login
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
# Nginx Proxy Manager login (email)
HOMEPAGE_VAR_NPM_EMAIL=
HOMEPAGE_VAR_NPM_PASS=
